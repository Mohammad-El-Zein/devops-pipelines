  "bugs": {
    "url": "https://github.com/Mohammad-El-Zein/devops-pipelines/issues"
  },
  "homepage": "https://github.com/Mohammad-El-Zein/devops-pipelines#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
