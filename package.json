{
  "name": "devops-pipelines",
  "version": "1.0.0",
  "description": "Small Node.js service used to demonstrate a production-grade CI/CD pipeline with GitHub Actions",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-include=src/**",
